---
import { zeroPad } from "../utils/calc"
import type { FacilityType } from "../libs/microCMS"
import { microcmsImage } from "../utils/microcmsImage"

interface Props {
    data: FacilityType[]
}

const { data } = Astro.props
---


<section class="facility --header_white" id="facility">
    <div class="facilityList">
        <div class="facilityList_sticky">
            <div class="facilityList_sticky_imgs">
                {data.map((item) => (
                    <img class="facilityList_sticky_img" src={microcmsImage(item.bg.url, {width: 2880, quality: 80})} src={item.bg.alt} width={item.bg.width}  height={item.bg.height}  />
                ))}
            </div>
            <div class="facilityList_sticky_wrapper">
                <div class="facilityList_sticky_textLeft">
                    <div class="facilityList_sticky_numbers">
                        <p class="facilityList_sticky_numbers_number">
                            {data.map((_, index) => (<span class="--counter">FACILITY&ensp;{zeroPad(index + 1, 2)}</span>))}
                        </p>
                    </div>
                    <div class="facilityList_sticky_title">
                        {data.map((item) => (
                            <h3 class="facilityList_sticky_title_inner">
                                <span class="--en">{item.titleEN}</span><span class="--hyphen"></span><span class="--jp">[{item.titleJP}]</span>
                            </h3>
                        ))}
                    </div>
                </div>
                <div class="facilityList_sticky_textRight">
                    {data.map((item) => (
                        <p class="facilityList_sticky_textRight_inner">{item.detail}</p>
                    ))}
                </div>
            </div>
        </div>
        <div class="facilityList_scroll">
            {
                [...Array(data.length + 1)].map(() => (
                    <div></div>
                )
            )}
        </div>
    </div>
</section>