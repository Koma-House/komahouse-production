---
import Address from '../components/Address.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { toAccess, toPet } from '../const/menu';
import Layout from '../layouts/Layout.astro';
import Image from 'astro/components/Image.astro';
import src_fv from "../assets/top/fv.jpg"
import SlTexts from '../components/SlTexts.astro';
import ShowImg from '../components/ShowImg.astro';
import src_concept from "../assets/top/concept.jpg"
import Facility from '../components/Facility.astro';
import Others from '../components/Others.astro';
import Gallery from '../components/Gallery.astro';
import Faq from '../components/Faq.astro';
import src_1f from "../assets/top/map.png"
import { microcms } from "../libs/microCMS"
import type { FacilityType, FaqType, InformationType } from '../libs/microCMS';

const facilities = await microcms.getAllContents<FacilityType>({
    endpoint: "facility",
    queries: {
      orders: "-system:default",
    },
});

const faqs = await microcms.getAllContents<FaqType>({
    endpoint: "faq",
    queries: {
      orders: "-system:default",
    },
});

const info = await microcms.getObject<InformationType>({
  endpoint: "information",
});

console.log(info.access[0])
---

<Layout>
	<article id="pageContainer" class="top" data-pageId="top">
		<section class="fv --header_white">
			<div class="fv_bg">
				<Image src={src_fv} alt={""} class:list={"fv_bg_img"} loading={"eager"} fetchpriority={"high"}/>
			</div>
			<div class="fv_texts">
				<p class='fv_texts_main'>
					<SlTexts className='--01' tag='span' texts={["GROWING"]} noSplit noInview noClip /><span class="--space">&nbsp;</span>
					<SlTexts className='--02' tag='span' texts={["OLDER,"]} noSplit noInview noClip/><span class="--space">&nbsp;</span>
					<SlTexts className='--03' tag='span' texts={["TOGETHER."]} noSplit noInview noClip/>
				</p>
				<h1 class="fv_texts_sub">
					時間を継いで、<br />かわりながら育っていく宿。
				</h1>
			</div>
			<div class="fv_shutter"></div>
		</section>
		<section class="concept" id="concept">
			<h2 class="concept_heading">CONCEPT</h2>
			<div class="cencept_caths">
				<h3 class="cencept_cath --en">
					<span>PLACE FOR YOU<br /></span>
					<span>TO REST YOUR<br /></span>
					<span>HEART</span>
				</h3>
				<p class="cencept_cath --jp"><span>それぞれのペースで過ごす、<br /></span><span>一棟貸切の宿。</span></p>
			</div>
			<div class="cencept_itemBox">
				<ShowImg src={src_concept} />
				<p class="cencept_text">
					時間を継いで、かわりながら育っていく宿。<br />
					築50年の民家をリノベーションした、<br />
					一棟貸切の空間。
				</p>
			</div>
		</section>
		<Facility data={facilities} />
		<Others />
		<section class="floor">
			<div class="floor_texts">
				<SectionHeading main={"Floor Map"} />
			</div>
			<div class="map">
				<div class="map_inner">
					<Image class:list={"floor_map"} src={src_1f} alt={""} />
				</div>
				<button
					class="map_barrier"
					type="button"
					aria-label="マップを操作する"
				>
					<span>
						<span class="--pulse">クリックして操作を開始</span>
					</span>
				</button>
				<button class="map_guide">
					<div class="--open">
						ドラッグ … 移動<br />
						ピンチ / ホイール … 拡大縮小
					</div>
				</button>
			</div>
		</section>
		<Gallery />
		<section class="access" id="access">
			<div class="access_wrapper">
				<div class="access_text">
					<div class="access_block">
						<SectionHeading main={toAccess.title} />
						<div class="access_map">
							<iframe src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d5267.343639442746!2d139.92978049947922!3d35.37934709388702!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x60180dbd4f12b665%3A0x110a6d7d5a99731a!2sKOMA%20HOUSE!5e0!3m2!1sja!2sjp!4v1791529608557!5m2!1sja!2sjp" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
						</div>
						<p class="access_block_content">
							<Address /><br /><br />
							{info.access.map((item, index) => (
								<>
									<span class="--indent">
										{item.title}<br />
										{item.detail}
									</span>{index !== info.access.length - 1 && <br />}
								</>
							))}
						</p>
					</div>
					<div class="access_block">
						<SectionHeading main={"Information"} />
						<p class="access_block_content">
							<span class="--table">
								<span class="--th">Check In</span><span>14:00〜</span>
							</span><br />
							<span class="--table">
								<span class="--th">Check Out</span><span>〜11:00</span>
							</span><br /><br />
							<span class="--table">
								<span class="--th">定員</span><span>大人10名まで</span><br />
								<small>＊未就学児の添い寝は宿泊人数に含みません</small>
							</span><br /><br />
							<span class="--indent">
								<span>
									ペット可<br />
									大切な家族と、同じ時間を。<br />
									室内だけでなく、庭でも自由に過ごせる宿です。<br />
									くつろぐ愛犬の姿も、旅の大切な一コマに。<br />
									<small>＊<a href={`${toPet.href}`}>利用条件</a>がございますので、事前にご確認ください。</small>
								</span>
							</span>
						</p>
					</div>
					<div class="access_block">
						<SectionHeading main={"Facilities"} />
						<p class="access_block_note">＊季節や仕入れ状況により変わることがあります。<br class="--sp" />予めご了承ください。</p>
						<div class="access_block_content --faci">
							<ul class="access_block_grid">
								{info.facilities.map((child) => (
									<li class="--indent">
										{child.title}<br />
										{child.body.map((grandChild, index) => (
											<>{grandChild.title}{index !== child.body.length - 1 && <br />}</>
										))}
									</li>
								))}
							</ul>
						</div>
					</div>
				</div>
			</div>
		</section>
		<Faq data={faqs} />
	</article>
</Layout>
